                    "spec": {
                      "editorMode": "code",
                      "expr": "max by (instance) (blocknode_app_state_status{environment=~\"$environment\", instance=~\"$instance\"})",
                      "legendFormat": "{{instance}}",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "",
        "id": 1,
        "links": [],
        "title": "Node Status",
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "mappings": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Starting",
                        "color": "yellow"
                      },
                      "1": {
                        "text": "Running",
                        "color": "green"
                      },
                      "2": {
                        "text": "Shutting Down",
                        "color": "orange"
                      }
                    }
                  }
                ],
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 2
                    }
                  ]
                },
                "unit": "none"
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "justifyMode": "auto",
              "orientation": "auto",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
                ],
                "fields": "",
                "values": false
              },
              "showPercentChange": false,
              "textMode": "auto",
              "wideLayout": true
            },
            "version": "12.3.2"
          }
        }
      }
    },
