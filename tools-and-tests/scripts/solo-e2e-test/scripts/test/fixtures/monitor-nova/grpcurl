#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Fake grpcurl for the real monitor-block-proofs.sh: a chain from a Consensus Node on the
# Nova WRAPS library. Every signed block carries the single 13712 byte layout from the
# start; every block that is a multiple of 20 carries a block state proof instead, which
# the monitor must skip rather than count or fail on.
set -euo pipefail
FIXTURES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# The monitor passes -d {"block_number": N}; pick N out of the arguments.
block=$(printf "%s\n" "$@" | sed -n 's/.*"block_number": *\([0-9][0-9]*\).*/\1/p')
if [[ $(( block % 20 )) -eq 0 ]]; then
  "${FIXTURES_DIR}/fake-block-json.sh" state-proof
else
  "${FIXTURES_DIR}/fake-block-json.sh" signed 13712
fi
