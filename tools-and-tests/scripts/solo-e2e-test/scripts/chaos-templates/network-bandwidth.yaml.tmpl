#
# NetworkChaos template — bandwidth throttle injection.
# Uses tc tbf (token bucket filter) to cap throughput leaving the selector
# pods. TARGET_BLOCK is either a pod-selector `target:` block, or an
# `externalTargets:` IP list when the packet's real destination (as seen at
# the point tc/ipset filters it, inside the selector's own netns) is a k8s
# Service ClusterIP rather than a pod IP — see execute_inject_bandwidth in
# solo-test-runner.sh for why that distinction matters.
# Filled at apply time by solo-test-runner.sh via envsubst.
#
# Pod-label selectors:
#   CN side → solo.hedera.com/type=network-node
#   BN side → block-node.hiero.com/type=block-node
apiVersion: chaos-mesh.org/v1alpha1
kind: NetworkChaos
metadata:
  name: ${CHAOS_NAME}
  namespace: chaos-mesh
  labels:
    solo-e2e-test/test-id: "${TEST_ID}"
    solo-e2e-test/scenario-id: "${SCENARIO_ID}"
    solo-e2e-test/managed-by: solo-test-runner
spec:
  action: bandwidth
  mode: all
  direction: ${DIRECTION}
  selector:
    namespaces:
      - ${TARGET_NAMESPACE}
    labelSelectors:
      ${SOURCE_LABEL_KEY}: ${SOURCE_LABEL_VALUE}
${SOURCE_NAME_FILTER}
${TARGET_BLOCK}
  bandwidth:
    rate: '${BANDWIDTH_RATE}'
    limit: ${BANDWIDTH_LIMIT}
    buffer: ${BANDWIDTH_BUFFER}
