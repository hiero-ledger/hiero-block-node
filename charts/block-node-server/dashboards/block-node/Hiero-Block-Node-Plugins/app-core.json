          "mappings": [
            {
              "options": {
                "0": {
                  "color": "yellow",
                  "text": "Starting"
                },
                "1": {
                  "color": "green",
                  "text": "Running"
                },
                "2": {
                  "color": "orange",
                  "text": "Shutting Down"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
